<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_picking_form_begleitschein" model="ir.ui.view">
            <field name="name">stock.picking.form</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="oe_stat_button"
                            name="action_view_begleitscheine"
                            type="object"
                            icon="fa-truck">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="begleitscheine" widget="statinfo"/>
                            </span>
                        </div>
                    </button>
                </xpath>
                <xpath expr="//header" position="inside">
                    <button name="create_begleitschein" type="object" string="Create Begleitschein"
                            class="oe_highlight" />
                    <button name="start_transport" type="object" string="Start Transport"
                            class="oe_highlight" invisible="begleitschein_status != 'new'" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>