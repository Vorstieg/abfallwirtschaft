<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_form_inherit_abfall_fsm_dispatch" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.abfall.fsm.dispatch</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list/field[@name='quantity']" position="after">
                <field name="show_weigh_quantity_button" column_invisible="True"/>
                <button name="action_weigh_quantity"
                        string="Menge verwiegen"
                        type="object"
                        class="btn-secondary"
                        invisible="not show_weigh_quantity_button or not is_quantity_done_editable"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_dispatch_lists"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-list"
                        invisible="dispatch_list_count == 0">
                    <field name="dispatch_list_count" widget="statinfo" string="Dispatch Lists"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
