<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_waste_reclassification_reason_list" model="ir.ui.view">
        <field name="name">waste.reclassification.reason.list</field>
        <field name="model">waste.reclassification.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="gtin"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="action_waste_reclassification_reason" model="ir.actions.act_window">
        <field name="name">Reclassification Reasons</field>
        <field name="res_model">waste.reclassification.reason</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
