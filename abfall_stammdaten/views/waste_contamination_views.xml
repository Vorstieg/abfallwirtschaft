<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_waste_contamination_type" model="ir.actions.act_window">
        <field name="name">Waste Contamination Types</field>
        <field name="res_model">waste.contamination.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new waste contamination type
            </p>
        </field>
    </record>

    <record id="view_waste_contamination_type_list" model="ir.ui.view">
        <field name="name">waste.contamination.type.list</field>
        <field name="model">waste.contamination.type</field>
        <field name="arch" type="xml">
            <list string="Waste Contamination Types">
                <field name="name"/>
                <field name="gtin"/>
            </list>
        </field>
    </record>

    <record id="view_waste_contamination_type_form" model="ir.ui.view">
        <field name="name">waste.contamination.type.form</field>
        <field name="model">waste.contamination.type</field>
        <field name="arch" type="xml">
            <form string="Waste Contamination Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="gtin"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_waste_contamination_type_search" model="ir.ui.view">
        <field name="name">waste.contamination.type.search</field>
        <field name="model">waste.contamination.type</field>
        <field name="arch" type="xml">
            <search string="Waste Contamination Types">
                <field name="name" string="Name"/>
                <field name="gtin" string="GTIN"/>
            </search>
        </field>
    </record>
</odoo>