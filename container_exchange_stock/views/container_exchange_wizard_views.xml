<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_container_exchange_wizard_form" model="ir.ui.view">
        <field name="name">container.exchange.wizard.form</field>
        <field name="model">container.exchange.wizard</field>
        <field name="arch" type="xml">
            <form string="Container austauschen">
                <group>
                    <field name="sale_order_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="returnable_lot_ids" invisible="1"/>
                    <field name="deliverable_lot_ids" invisible="1"/>
                    <field name="return_lot_id" required="1"/>
                    <field name="delivery_lot_id" required="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Lieferscheine erstellen" class="btn-primary"/>
                    <button string="Abbrechen" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
