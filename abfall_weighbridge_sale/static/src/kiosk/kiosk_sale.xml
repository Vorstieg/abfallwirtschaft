<templates xml:space="preserve">
    <t t-name="abfall_weighbridge_sale.Kiosk" t-inherit="abfall_weighbridge.Kiosk" t-inherit-mode="extension">
        <xpath expr="//button[@t-on-click='createTicket']" position="before">
            <div t-if="state.commercialRole === 'sale'" class="mt-3">
                <label class="form-label">Sales order line</label>
                <select class="form-select form-select-lg" t-model.number="state.saleLineId">
                    <option value="0">Spot sale (create a new order)</option>
                    <option t-foreach="state.saleLines" t-as="line" t-key="line.id" t-att-value="line.id" t-esc="line.label"/>
                </select>
            </div>
        </xpath>
    </t>
</templates>
