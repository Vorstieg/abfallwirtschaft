<odoo>
    <record id="view_weighbridge_ticket_form_sale" model="ir.ui.view">
        <field name="name">weighbridge.ticket.form.sale</field><field name="model">weighbridge.ticket</field><field name="inherit_id" ref="abfall_weighbridge.view_weighbridge_ticket_form"/>
        <field name="arch" type="xml">
            <field name="commercial_role" position="after"><field name="sale_line_id" invisible="commercial_role != 'sale'" readonly="state != 'draft'"/><field name="sale_order_id" invisible="not sale_order_id"/><field name="price_unit" invisible="commercial_role != 'sale'"/><field name="currency_id" invisible="commercial_role != 'sale'"/><field name="manual_price" invisible="commercial_role != 'sale'"/><field name="manual_price_reason" invisible="commercial_role != 'sale' or not manual_price"/></field></field>
    </record>
</odoo>
