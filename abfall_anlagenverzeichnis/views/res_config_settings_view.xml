<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_waste_management_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.eras</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="Waste Management" string="Waste Management"
                         name="abfall_anlagenverzeichnis">
                        <block title="eRAS Registerabfrage" name="eras_settings">
                            <setting help="Credentials for eRAS Registerabfrage API">
                                <group>
                                    <field name="eras_api_user"/>
                                    <field name="eras_api_password" password="True"/>
                                    <field name="eras_base_url"/>
                                </group>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>
    </data>

    <record id="action_waste_management_config_settings" model="ir.actions.act_window">
            <field name="name">Configure Waste Management</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="res_config_settings_waste_management_view_form"/>
            <field name="context">{'module' : 'abfall_anlagenverzeichnis'}</field>
        </record>


    <menuitem id="menu_waste_management_settings"
              name="Settings"
              parent="abfall_stammdaten.menu_waste_management_configuration"
              action="action_waste_management_config_settings"
              sequence="10"
    />
</odoo>
