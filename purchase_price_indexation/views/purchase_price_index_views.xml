<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_price_index_tree" model="ir.ui.view">
        <field name="name">purchase.price.index.tree</field>
        <field name="model">purchase.price.index</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_price_index_form" model="ir.ui.view">
        <field name="name">purchase.price.index.form</field>
        <field name="model">purchase.price.index</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Values">
                            <field name="value_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="value"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_purchase_price_index_value_tree" model="ir.ui.view">
        <field name="name">purchase.price.index.value.tree</field>
        <field name="model">purchase.price.index.value</field>
        <field name="arch" type="xml">
            <list>
                <field name="index_id"/>
                <field name="date"/>
                <field name="value"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_purchase_price_index" model="ir.actions.act_window">
        <field name="name">Price Indexes</field>
        <field name="res_model">purchase.price.index</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_purchase_price_index_root" name="Price Indexes" parent="purchase.menu_purchase_config" sequence="60" groups="purchase.group_purchase_manager"/>
    <menuitem id="menu_purchase_price_index" name="Indexes" parent="menu_purchase_price_index_root" action="action_purchase_price_index" sequence="10" groups="purchase.group_purchase_manager"/>
</odoo>
