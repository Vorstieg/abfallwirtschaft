<odoo>
    <record id="view_weighbridge_billing_profile_list" model="ir.ui.view"><field name="name">weighbridge.billing.profile.list</field><field name="model">weighbridge.billing.profile</field><field name="arch" type="xml">
        <list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="company_id"/><field name="partner_id"/><field name="commercial_role"/><field name="billing_mode"/><field name="billing_day"/><field name="active"/></list></field></record>
    <record id="action_weighbridge_billing_profile" model="ir.actions.act_window"><field name="name">Billing Profiles</field><field name="res_model">weighbridge.billing.profile</field><field name="view_mode">list,form</field></record>
    <record id="view_weighbridge_station_form_billing" model="ir.ui.view"><field name="name">weighbridge.station.form.billing</field><field name="model">weighbridge.station</field><field name="inherit_id" ref="abfall_weighbridge.view_weighbridge_station_form"/><field name="arch" type="xml">
        <xpath expr="//field[@name='connection_state']/ancestor::group[1]" position="before"><group string="Billing"><field name="billing_mode"/><field name="billing_day"/></group></xpath></field></record>
    <record id="view_weighbridge_ticket_form_billing" model="ir.ui.view"><field name="name">weighbridge.ticket.form.billing</field><field name="model">weighbridge.ticket</field><field name="inherit_id" ref="abfall_weighbridge.view_weighbridge_ticket_form"/><field name="arch" type="xml">
        <xpath expr="//header/field[@name='state']" position="before"><button name="action_process_billing" type="object" string="Process Billing" groups="abfall_weighbridge_billing.group_weighbridge_accounting" invisible="state != 'completed' or stock_state != 'done' or billing_state in ('posted','reversed','not_applicable')"/></xpath><xpath expr="//field[@name='payable_weight_kg']/ancestor::group[1]" position="after"><group string="Billing"><field name="billing_mode"/><field name="billing_state"/><field name="billing_error" invisible="not billing_error"/><field name="invoice_ids" widget="many2many_tags"/></group></xpath></field></record>
    <record id="view_weighbridge_ticket_list_billing" model="ir.ui.view"><field name="name">weighbridge.ticket.list.billing</field><field name="model">weighbridge.ticket</field><field name="inherit_id" ref="abfall_weighbridge.view_weighbridge_ticket_list"/><field name="arch" type="xml">
        <field name="state" position="after"><field name="billing_state"/></field></field></record>
    <record id="abfall_weighbridge.menu_weighbridge_root" model="ir.ui.menu"><field name="group_ids" eval="[(4, ref('group_weighbridge_accounting'))]"/></record>
    <record id="abfall_weighbridge.menu_weighbridge_configuration" model="ir.ui.menu"><field name="group_ids" eval="[(4, ref('group_weighbridge_accounting'))]"/></record>
    <menuitem id="menu_weighbridge_billing" name="Billing Profiles" parent="abfall_weighbridge.menu_weighbridge_configuration" action="action_weighbridge_billing_profile" groups="group_weighbridge_accounting"/>
</odoo>
