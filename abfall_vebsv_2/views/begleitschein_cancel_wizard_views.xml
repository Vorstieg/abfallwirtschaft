<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_begleitschein_cancel_wizard_form" model="ir.ui.view">
        <field name="name">begleitschein.cancel.wizard.form</field>
        <field name="model">begleitschein.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Begleitschein">
                <group>
                    <div class="alert alert-warning" role="alert">
                        <strong><i class="fa fa-exclamation-triangle"/> Warning!</strong>
                        You are about to cancel this Begleitschein. This action may require coordination with the transport partner.
                        Please confirm the cancellation reason.
                    </div>
                    <field name="begleitschein_id" readonly="1"/>
                    <field name="revocation_reason_id" required="1" placeholder="Select a reason..."/>
                </group>
                <footer>
                    <button string="Confirm Cancellation" name="action_cancel_begleitschein" type="object" class="btn-danger"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

