<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_waste_begleitschein" model="ir.actions.act_window">
        <field name="name">Waste Begleitscheine</field>
        <field name="res_model">waste.begleitschein</field>
        <field name="view_mode">kanban,list,graph,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Begleitschein
            </p>
            <p>
                Track hazardous waste transport documentation compliant with Austrian ANV 2012 regulations.
            </p>
        </field>
    </record>

    <record id="view_waste_begleitschein_form" model="ir.ui.view">
        <field name="name">waste.begleitschein.form</field>
        <field name="model">waste.begleitschein</field>
        <field name="arch" type="xml">
            <form string="Waste Begleitschein">
                <header>
                    <button name="start_begleitschein" type="object" string="Declare Begleitschein" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="confirm_begleitschein" type="object" string="Confirm Handover" class="oe_highlight"
                            invisible="state != 'declared' or self_is_main_organizer"/>
                    <button name="start_transport" type="object" string="Start Transport" class="oe_highlight"
                            invisible="state != 'confirmed'"/>
                    <button name="end_transport" type="object" string="End Transport" class="oe_highlight"
                            invisible="state not in ['in_transport', 'transport_complete']"/>
                    <button name="cancel_begleitschein" type="object" string="Cancel" class="btn-secondary"
                            invisible="not is_cancel_button_visible"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="declared,confirmed,in_transport,done" nolabel="1"/>
                </header>
                <sheet>
                    <!-- State Ribbons -->
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'canceled'"/>
                    <widget name="web_ribbon" title="Draft" bg_color="text-bg-secondary" invisible="state != 'draft'"/>

                    <field name="self_is_main_organizer" invisible="1"/>
                    <field name="is_cancel_button_visible" invisible="1"/>

                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_view_stock_picking" type="object" icon="fa-truck"
                                invisible="not stock_picking_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Picking</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" default_focus="1" placeholder="Begleitschein Reference"/>
                        </h1>
                    </div>

                    <group>
                        <group string="General">
                            <field name="stock_picking_id" readonly="1"/>
                            <field name="organizing_partner_id" readonly="1"/>
                            <field name="total_product_qty" readonly="1"/>
                        </group>
                        <group string="Transport">
                            <field name="transport_partner_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="transport_mode_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="dropship_partner_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>

                    <group>
                        <group string="Source (Handover)">
                            <field name="source_partner_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="source_site" domain="[('partner_id', '=', source_partner_id)]"
                                   placeholder="Select treatment site..."/>
                            <field name="source_installation" domain="[('treatment_site_id', '=', source_site)]"
                                   placeholder="Select installation..."/>
                        </group>
                        <group string="Target (Takeover)">
                            <field name="target_partner_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="target_site" domain="[('partner_id', '=', target_partner_id)]"
                                   placeholder="Select treatment site..."/>
                            <field name="target_installation" domain="[('treatment_site_id', '=', target_site)]"
                                   placeholder="Select installation..."/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Waste Lines" name="lines">
                            <field name="begleitschein_lines">
                                <list string="Begleitschein Lines" editable="bottom">
                                    <field name="abfallart" string="Waste Type"/>
                                    <field name="waste_contamination" string="Contamination"/>
                                    <field name="quantification_type_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="product_qty" string="Quantity (kg)" sum="Total"/>
                                    <field name="contains_pop" string="POP" widget="boolean_toggle"/>
                                    <field name="vebsv_id" string="VEBSV ID" optional="show"/>
                                    <field name="product_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Technical" name="technical" groups="base.group_no_one">
                            <group>
                                <group string="UUIDs">
                                    <field name="shipment_uuid" readonly="1"/>
                                    <field name="business_case_uuid" readonly="1"/>
                                    <field name="transport_uuid" readonly="1"/>
                                </group>
                                <group string="Company">
                                    <field name="company_id" readonly="1"/>
                                    <field name="company_partner_id" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="o_attachment_preview"/>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_waste_begleitschein_search" model="ir.ui.view">
        <field name="name">waste.begleitschein.search</field>
        <field name="model">waste.begleitschein</field>
        <field name="arch" type="xml">
            <search string="Search Begleitscheine">
                <field name="name"/>
                <field name="source_partner_id"/>
                <field name="target_partner_id"/>
                <field name="source_site"/>
                <field name="target_site"/>
                <field name="transport_partner_id"/>
                <field name="transport_mode_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Declared" name="declared" domain="[('state', '=', 'declared')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="In Transport" name="in_transport" domain="[('state', '=', 'in_transport')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Canceled" name="canceled" domain="[('state', '=', 'canceled')]"/>
                <separator/>
                <filter string="Active" name="active" domain="[('state', 'not in', ['done', 'canceled'])]"/>
                <separator/>
                <filter string="Stage" name="group_by_stage" context="{'group_by': 'stage_id'}"/>
                <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                <filter string="Source Partner" name="group_by_source_partner" context="{'group_by': 'source_partner_id'}"/>
                <filter string="Target Partner" name="group_by_target_partner" context="{'group_by': 'target_partner_id'}"/>
                <filter string="Transport Partner" name="group_by_transport_partner" context="{'group_by': 'transport_partner_id'}"/>
                <filter string="Source Site" name="group_by_source_site" context="{'group_by': 'source_site'}"/>
                <filter string="Target Site" name="group_by_target_site" context="{'group_by': 'target_site'}"/>
            </search>
        </field>
    </record>

    <record id="view_waste_begleitschein_kanban" model="ir.ui.view">
        <field name="name">waste.begleitschein.kanban</field>
        <field name="model">waste.begleitschein</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" quick_create="false" records_draggable="false" sample="1">
                <field name="stage_id"/>
                <field name="state"/>
                <field name="source_partner_id"/>
                <field name="target_partner_id"/>
                <field name="source_site"/>
                <field name="target_site"/>
                <field name="total_product_qty"/>
                <field name="name"/>
                <field name="contains_pop"/>
                <progressbar field="state" colors='{"draft": "secondary", "declared": "warning", "confirmed": "info", "in_transport": "primary", "transport_complete": "primary", "done": "success", "canceled": "danger"}'/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click d-flex flex-column h-100 p-3">
                            <div class="o_kanban_record_main mb-2">
                                <div class="d-flex align-items-center mb-1">
                                    <field name="name" class="fw-bold fs-5 text-primary"/>
                                    <div class="ms-auto d-flex gap-2 align-items-center">
                                        <span class="badge rounded-pill text-bg-danger py-1 px-2 fw-bold" invisible="not contains_pop" title="Contains POP waste">
                                            POP
                                        </span>
                                        <span class="badge rounded-pill text-bg-info py-1 px-2 fw-bold">
                                            <field name="total_product_qty"/> kg
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_subtitle d-flex flex-column gap-1">
                                    <div class="d-flex align-items-center text-muted small" invisible="not source_site">
                                        <i class="fa fa-truck text-success me-2" title="Source Site"/>
                                        <field name="source_site" class="text-truncate"/>
                                    </div>
                                    <div class="d-flex align-items-center text-muted small" invisible="not target_site">
                                        <i class="fa fa-map-marker text-danger me-2" title="Target Site"/>
                                        <field name="target_site" class="text-truncate"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-auto pt-2 border-top d-flex align-items-center justify-content-between">
                                <div class="oe_kanban_bottom_left d-flex align-items-center">
                                    <field name="source_partner_id" widget="many2one_avatar" options="{'no_open': True}"/>
                                    <i class="fa fa-long-arrow-right mx-2 text-muted" title="Transfer to"/>
                                    <field name="target_partner_id" widget="many2one_avatar" options="{'no_open': True}"/>
                                </div>

                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_waste_begleitschein_graph" model="ir.ui.view">
        <field name="name">waste.begleitschein.graph</field>
        <field name="model">waste.begleitschein</field>
        <field name="arch" type="xml">
            <graph string="Waste Begleitschein" type="bar" stacked="True" sample="1">
                <field name="state"/>
                <field name="total_product_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_waste_begleitschein_list" model="ir.ui.view">
        <field name="name">waste.begleitschein.list</field>
        <field name="model">waste.begleitschein</field>
        <field name="arch" type="xml">
            <list string="Waste Begleitschein" multi_edit="1" sample="1"
                  decoration-muted="state == 'canceled'"
                  decoration-info="state == 'draft'"
                  decoration-warning="state in ['declared', 'confirmed']"
                  decoration-success="state == 'done'">
                <field name="name" decoration-bf="1"/>
                <field name="source_partner_id" optional="show"/>
                <field name="target_partner_id" optional="show"/>
                <field name="source_site" optional="show"/>
                <field name="target_site" optional="show"/>
                <field name="transport_partner_id" optional="hide"/>
                <field name="total_product_qty" string="Qty (kg)" sum="Total" optional="show"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-warning="state in ['declared', 'confirmed']"
                       decoration-info="state == 'in_transport'"
                       decoration-primary="state == 'transport_complete'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'canceled'"/>
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="view_begleitschein_modal_form">
        <field name="name">begleitschein.modal.form</field>
        <field name="model">begleitschein.modal</field>
        <field name="arch" type="xml">
            <form string="Create Begleitschein">
                <sheet>
                    <group>
                        <group string="Partners">
                            <field name="source_partner_id" readonly="true"/>
                            <field name="target_partner_id" readonly="true"/>
                        </group>
                        <group string="Sites">
                            <field name="source_site" domain="[('partner_id', '=', source_partner_id)]"
                                   placeholder="Select source site..."/>
                            <field name="target_site" domain="[('partner_id', '=', target_partner_id)]"
                                   placeholder="Select target site..."/>
                        </group>
                    </group>
                    <footer>
                        <button string="Confirm" type="object" name="create_begleitschein_action" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem
            id="menu_waste_begleitschein_list"
            name="Begleitscheine"
            parent="abfall_stammdaten.menu_abfall_stammdaten_root"
            action="action_waste_begleitschein"
            sequence="20"/>
</odoo>
