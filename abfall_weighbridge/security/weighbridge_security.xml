<odoo>
    <record id="module_category_weighbridge" model="ir.module.category">
        <field name="name">Weighbridge</field>
        <field name="sequence">35</field>
    </record>
    <record id="privilege_weighbridge_operations" model="res.groups.privilege">
        <field name="name">Weighbridge Operations</field>
        <field name="category_id" ref="module_category_weighbridge"/>
    </record>
    <record id="group_weighbridge_operator" model="res.groups">
        <field name="name">Operator</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_weighbridge_operations"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_weighbridge_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_weighbridge_operations"/>
        <field name="implied_ids" eval="[(4, ref('group_weighbridge_operator'))]"/>
    </record>
    <record id="group_weighbridge_station_admin" model="res.groups">
        <field name="name">Station Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_weighbridge_operations"/>
        <field name="implied_ids" eval="[(4, ref('group_weighbridge_manager'))]"/>
    </record>

    <record id="rule_station_company" model="ir.rule">
        <field name="name">Weighbridge stations by company</field>
        <field name="model_id" ref="model_weighbridge_station"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ticket_company" model="ir.rule">
        <field name="name">Weighbridge tickets by company</field>
        <field name="model_id" ref="model_weighbridge_ticket"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_measurement_company" model="ir.rule">
        <field name="name">Weighbridge measurements by company</field>
        <field name="model_id" ref="model_weighbridge_measurement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_challenge_company" model="ir.rule">
        <field name="name">Weighbridge challenges by company</field>
        <field name="model_id" ref="model_weighbridge_capture_challenge"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
