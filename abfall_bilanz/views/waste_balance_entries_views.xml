<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Storage State Views -->
    <record id="view_waste_storage_state_form" model="ir.ui.view">
        <field name="name">waste.storage.state.form</field>
        <field name="model">waste.storage.state</field>
        <field name="arch" type="xml">
            <form string="Storage State">
                <header>
                    <button name="action_approve" type="object" string="Approve" 
                            class="btn-primary" invisible="state == 'approved'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Location">
                            <field name="installation_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Details">
                            <field name="reporting_date"/>
                            <field name="abfallart"/>
                        </group>
                    </group>
                    <group>
                        <group string="Quantity">
                            <field name="amount"/>
                            <field name="quantification_type"/>
                            <field name="buffer_type_code"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_waste_storage_state_list" model="ir.ui.view">
        <field name="name">waste.storage.state.list</field>
        <field name="model">waste.storage.state</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-info="state == 'draft'" decoration-success="state == 'approved'">
                <field name="installation_id"/>
                <field name="reporting_date"/>
                <field name="abfallart"/>
                <field name="amount" sum="Total (kg)"/>
                <field name="quantification_type"/>
                <field name="buffer_type_code" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'approved'"/>
                <button name="action_approve" type="object" string="Approve" class="btn-sm btn-primary" invisible="state == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="view_waste_storage_state_search" model="ir.ui.view">
        <field name="name">waste.storage.state.search</field>
        <field name="model">waste.storage.state</field>
        <field name="arch" type="xml">
            <search string="Storage States">
                <field name="installation_id"/>
                <field name="abfallart"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <separator/>
                <filter string="This Year" name="this_year"
                        domain="[('reporting_date', '&gt;=', time.strftime('%Y-01-01')),
                                 ('reporting_date', '&lt;=', time.strftime('%Y-12-31'))]"/>
                <separator/>
                <filter string="Installation" name="group_installation" context="{'group_by':'installation_id'}"/>
                <filter string="Waste Type" name="group_abfallart" context="{'group_by':'abfallart'}"/>
                <filter string="Year" name="group_year" context="{'group_by':'reporting_date:year'}"/>
                <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_waste_storage_state" model="ir.actions.act_window">
        <field name="name">Storage States (Lagerstände)</field>
        <field name="res_model">waste.storage.state</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_waste_storage_state_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record storage states for your installations
            </p>
            <p>
                Storage states track the amount of waste stored at each installation.
                Use "Calculate Inventory" in the Report Wizard to auto-generate end-of-year states.
            </p>
        </field>
    </record>

    <!-- Storage Correction Views -->
    <record id="view_waste_storage_correction_form" model="ir.ui.view">
        <field name="name">waste.storage.correction.form</field>
        <field name="model">waste.storage.correction</field>
        <field name="arch" type="xml">
            <form string="Storage Correction">
                <sheet>
                    <group>
                        <group string="Location">
                            <field name="installation_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Details">
                            <field name="reporting_date"/>
                            <field name="abfallart"/>
                        </group>
                    </group>
                    <group>
                        <group string="Correction">
                            <field name="amount"/>
                            <field name="quantification_type"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_waste_storage_correction_list" model="ir.ui.view">
        <field name="name">waste.storage.correction.list</field>
        <field name="model">waste.storage.correction</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-danger="amount &lt; 0" decoration-success="amount &gt; 0">
                <field name="installation_id"/>
                <field name="reporting_date"/>
                <field name="abfallart"/>
                <field name="amount" sum="Net Correction (kg)"/>
                <field name="quantification_type"/>
            </list>
        </field>
    </record>

    <record id="view_waste_storage_correction_search" model="ir.ui.view">
        <field name="name">waste.storage.correction.search</field>
        <field name="model">waste.storage.correction</field>
        <field name="arch" type="xml">
            <search string="Storage Corrections">
                <field name="installation_id"/>
                <field name="abfallart"/>
                <separator/>
                <filter string="Additions (+)" name="additions" domain="[('amount', '&gt;', 0)]"/>
                <filter string="Removals (-)" name="removals" domain="[('amount', '&lt;', 0)]"/>
                <separator/>
                <filter string="This Year" name="this_year"
                        domain="[('reporting_date', '&gt;=', time.strftime('%Y-01-01')),
                                 ('reporting_date', '&lt;=', time.strftime('%Y-12-31'))]"/>
                <separator/>
                <filter string="Installation" name="group_installation" context="{'group_by':'installation_id'}"/>
                <filter string="Waste Type" name="group_abfallart" context="{'group_by':'abfallart'}"/>
                <filter string="Year" name="group_year" context="{'group_by':'reporting_date:year'}"/>
            </search>
        </field>
    </record>

    <record id="action_waste_storage_correction" model="ir.actions.act_window">
        <field name="name">Storage Corrections</field>
        <field name="res_model">waste.storage.correction</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_waste_storage_correction_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record storage corrections
            </p>
            <p>
                Use corrections to adjust inventory amounts that cannot be explained by normal handovers/takeovers.
            </p>
        </field>
    </record>

    <!-- Reclassification Views -->
    <record id="view_waste_reclassification_form" model="ir.ui.view">
        <field name="name">waste.reclassification.form</field>
        <field name="model">waste.reclassification</field>
        <field name="arch" type="xml">
            <form string="Waste Reclassification">
                <sheet>
                    <group>
                        <group string="Location">
                            <field name="installation_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="reporting_date"/>
                        </group>
                        <group string="Reclassification">
                            <field name="preliminary_abfallart" string="From Waste Type"/>
                            <field name="new_abfallart" string="To Waste Type"/>
                            <field name="reclassification_reason_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Quantity">
                            <field name="amount"/>
                            <field name="quantification_type"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_waste_reclassification_list" model="ir.ui.view">
        <field name="name">waste.reclassification.list</field>
        <field name="model">waste.reclassification</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="installation_id"/>
                <field name="reporting_date"/>
                <field name="preliminary_abfallart" string="From"/>
                <field name="new_abfallart" string="To"/>
                <field name="amount" sum="Total (kg)"/>
                <field name="quantification_type"/>
                <field name="reclassification_reason_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_waste_reclassification_search" model="ir.ui.view">
        <field name="name">waste.reclassification.search</field>
        <field name="model">waste.reclassification</field>
        <field name="arch" type="xml">
            <search string="Waste Reclassifications">
                <field name="installation_id"/>
                <field name="preliminary_abfallart" string="Original Waste Type"/>
                <field name="new_abfallart" string="New Waste Type"/>
                <separator/>
                <filter string="This Year" name="this_year"
                        domain="[('reporting_date', '&gt;=', time.strftime('%Y-01-01')),
                                 ('reporting_date', '&lt;=', time.strftime('%Y-12-31'))]"/>
                <separator/>
                <filter string="Installation" name="group_installation" context="{'group_by':'installation_id'}"/>
                <filter string="Original Type" name="group_from" context="{'group_by':'preliminary_abfallart'}"/>
                <filter string="New Type" name="group_to" context="{'group_by':'new_abfallart'}"/>
                <filter string="Year" name="group_year" context="{'group_by':'reporting_date:year'}"/>
            </search>
        </field>
    </record>

    <record id="action_waste_reclassification" model="ir.actions.act_window">
        <field name="name">Waste Reclassifications</field>
        <field name="res_model">waste.reclassification</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_waste_reclassification_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record waste reclassifications
            </p>
            <p>
                Use reclassifications when waste is reassigned from one waste type code to another.
            </p>
        </field>
    </record>

    <!-- Remaining Capacity Views -->
    <record id="view_waste_remaining_capacity_form" model="ir.ui.view">
        <field name="name">waste.remaining.capacity.form</field>
        <field name="model">waste.remaining.capacity</field>
        <field name="arch" type="xml">
            <form string="Remaining Capacity">
                <sheet>
                    <group>
                        <group string="Location">
                            <field name="installation_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="reporting_date"/>
                        </group>
                        <group string="Capacity (m³)">
                            <field name="approved_remaining_capacity"/>
                            <field name="physical_remaining_capacity"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_waste_remaining_capacity_list" model="ir.ui.view">
        <field name="name">waste.remaining.capacity.list</field>
        <field name="model">waste.remaining.capacity</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="installation_id"/>
                <field name="reporting_date"/>
                <field name="approved_remaining_capacity" string="Approved (m³)"/>
                <field name="physical_remaining_capacity" string="Physical (m³)"/>
            </list>
        </field>
    </record>

    <record id="view_waste_remaining_capacity_search" model="ir.ui.view">
        <field name="name">waste.remaining.capacity.search</field>
        <field name="model">waste.remaining.capacity</field>
        <field name="arch" type="xml">
            <search string="Remaining Capacities">
                <field name="installation_id"/>
                <separator/>
                <filter string="This Year" name="this_year"
                        domain="[('reporting_date', '&gt;=', time.strftime('%Y-01-01')),
                                 ('reporting_date', '&lt;=', time.strftime('%Y-12-31'))]"/>
                <separator/>
                <filter string="Installation" name="group_installation" context="{'group_by':'installation_id'}"/>
                <filter string="Year" name="group_year" context="{'group_by':'reporting_date:year'}"/>
            </search>
        </field>
    </record>

    <record id="action_waste_remaining_capacity" model="ir.actions.act_window">
        <field name="name">Remaining Capacities</field>
        <field name="res_model">waste.remaining.capacity</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_waste_remaining_capacity_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record landfill remaining capacities
            </p>
            <p>
                Track the approved and physical remaining capacity of landfill installations.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_waste_storage_state" name="Storage States" parent="menu_bilanz_root" action="action_waste_storage_state" sequence="60"/>
    <menuitem id="menu_waste_storage_correction" name="Storage Corrections" parent="menu_bilanz_root" action="action_waste_storage_correction" sequence="70"/>
    <menuitem id="menu_waste_reclassification" name="Reclassifications" parent="menu_bilanz_root" action="action_waste_reclassification" sequence="80"/>
    <menuitem id="menu_waste_remaining_capacity" name="Remaining Capacities" parent="menu_bilanz_root" action="action_waste_remaining_capacity" sequence="90"/>
</odoo>
