        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_waste_management_reconciliation"
              name="Reconciliation"
              parent="product_waste_registry.menu_waste_management_configuration"
              sequence="60"/>

    <menuitem id="menu_reconciliation_site"
