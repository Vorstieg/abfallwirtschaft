    <!-- Actions -->
    <record id="action_reconciliation_site" model="ir.actions.act_window">
        <field name="name">Site Reconciliation Rules</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">reconciliation.site</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="reconciliation_site_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new site reconciliation rule.</p>
            <p>Drag to reorder priority. Lower priority = higher precedence.</p>
        </field>
    </record>

