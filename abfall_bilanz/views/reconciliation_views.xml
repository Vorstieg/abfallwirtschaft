<odoo>
    <!-- Site Reconciliation Views -->
    <record id="reconciliation_site_form_view" model="ir.ui.view">
        <field name="name">reconciliation.site.form</field>
        <field name="model">reconciliation.site</field>
        <field name="arch" type="xml">
            <form string="Site Reconciliation Rule">
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. Default Site for Partner X"/>
                        <field name="priority"/>
                        <field name="side"/>
                    </group>
                    <group string="Rule Conditions">
                        <field name="partner_id"/>
                        <field name="abfallart"/>
                    </group>
                    <group string="Result">
                        <field name="default_site"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="reconciliation_site_list_view" model="ir.ui.view">
        <field name="name">reconciliation.site.list</field>
        <field name="model">reconciliation.site</field>
        <field name="arch" type="xml">
            <list string="Site Reconciliation Rules">
                <field name="priority" widget="handle"/>
                <field name="name"/>
                <field name="side"/>
                <field name="partner_id"/>
                <field name="abfallart"/>
                <field name="default_site"/>
            </list>
        </field>
    </record>

    <record id="reconciliation_site_search_view" model="ir.ui.view">
        <field name="name">reconciliation.site.search</field>
        <field name="model">reconciliation.site</field>
        <field name="arch" type="xml">
            <search string="Site Rules">
                <field name="name"/>
                <field name="default_site"/>
                <field name="partner_id"/>
                <field name="abfallart"/>
                <separator/>
                <filter string="Source" name="source" domain="[('side', 'in', ['source', 'both'])]"/>
                <filter string="Target" name="target" domain="[('side', 'in', ['target', 'both'])]"/>
                <separator/>
                <filter string="Partner" name="group_partner" context="{'group_by':'partner_id'}"/>
                <filter string="Site" name="group_site" context="{'group_by':'default_site'}"/>
            </search>
        </field>
    </record>

    <!-- Installation Reconciliation Views -->
    <record id="reconciliation_installation_form_view" model="ir.ui.view">
        <field name="name">reconciliation.installation.form</field>
        <field name="model">reconciliation.installation</field>
        <field name="arch" type="xml">
            <form string="Installation Reconciliation Rule">
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. Default Installation for Site Y"/>
                        <field name="priority"/>
                        <field name="side"/>
                    </group>
                    <group string="Rule Conditions">
                        <field name="treatment_site"/>
                        <field name="abfallart"/>
                    </group>
                    <group string="Result">
                        <field name="default_installation"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="reconciliation_installation_list_view" model="ir.ui.view">
        <field name="name">reconciliation.installation.list</field>
        <field name="model">reconciliation.installation</field>
        <field name="arch" type="xml">
            <list string="Installation Reconciliation Rules">
                <field name="priority" widget="handle"/>
                <field name="name"/>
                <field name="side"/>
                <field name="treatment_site"/>
                <field name="abfallart"/>
                <field name="default_installation"/>
            </list>
        </field>
    </record>

    <record id="reconciliation_installation_search_view" model="ir.ui.view">
        <field name="name">reconciliation.installation.search</field>
        <field name="model">reconciliation.installation</field>
        <field name="arch" type="xml">
            <search string="Installation Rules">
                <field name="name"/>
                <field name="default_installation"/>
                <field name="treatment_site"/>
                <field name="abfallart"/>
                <separator/>
                <filter string="Source" name="source" domain="[('side', 'in', ['source', 'both'])]"/>
                <filter string="Target" name="target" domain="[('side', 'in', ['target', 'both'])]"/>
                <separator/>
                <filter string="Site" name="group_site" context="{'group_by':'treatment_site'}"/>
                <filter string="Installation" name="group_install" context="{'group_by':'default_installation'}"/>
            </search>
        </field>
    </record>

    <!-- Quantification Type Reconciliation Views -->
