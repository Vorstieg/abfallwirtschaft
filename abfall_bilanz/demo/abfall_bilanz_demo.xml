        </record>

        <!-- 3. Reclassification movement -->
        <record id="reclass_demo_2024" model="waste.reclassification">
            <field name="installation_id" ref="product_waste_anlagenverzeichnis.inst_demo_entsorgo_main"/>
            <field name="reporting_date">2024-09-10</field>
            <field name="preliminary_abfallart" ref="product_waste_registry.11102"/>
            <field name="new_abfallart" ref="product_waste_registry.11103"/>
